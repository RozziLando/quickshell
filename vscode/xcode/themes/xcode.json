    "tokenColors": [
        {
            "scope": [
                "comment"
            ],
            "settings": {
                "foreground": "#6c7986",
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "keyword.control",
                "keyword.operator"
            ],
            "settings": {
                "foreground": "#e2769e"
            }
        },
        {
            "scope": [
                "storage.type",
                "storage.modifier"
            ],
            "settings": {
                "foreground": "#e2769e"
            }
        },
        {
            "scope": [
                "entity.name.type",
                "support.type"
            ],
            "settings": {
                "foreground": "#88beb4"
            }
        },
        {
            "scope": [
                "entity.name.function"
            ],
            "settings": {
                "foreground": "#b992e5"
            }
        },
        {
            "scope": [
                "support.function"
            ],
            "settings": {
                "foreground": "#b992e5"
            }
        },
        {
            "scope": [
                "string"
            ],
            "settings": {
                "foreground": "#ff8170"
            }
        },
        {
            "scope": [
                "string.other.link"
            ],
            "settings": {
                "foreground": "#8a99a6"
            }
        },
        {
            "scope": [
                "constant.numeric"
            ],
            "settings": {
                "foreground": "#d0bf69"
            }
        },
        {
            "scope": [
                "variable",
                "meta.definition.variable"
            ],
            "settings": {
                "foreground": "#e6e6e6"
            }
        },
        {
            "scope": [
                "keyword.control.import",
                "entity.name.include"
            ],
            "settings": {
                "foreground": "#cf8545"
            }
        },
        {
            "scope": [
                "constant.language"
            ],
            "settings": {
                "foreground": "#f781b2"
            }
        },
        {
            "scope": [
                "variable.other",
                "variable.other.local"
            ],
            "settings": {
                "foreground": "#e6e6e6"
            }
        },
        {
            "scope": [
                "variable.other.global",
                "variable.language"
            ],
            "settings": {
                "foreground": "#e6e6e6"
            }
        },
        {
            "scope": [
                "entity.name.property",
                "entity.name.field"
            ],
            "settings": {
                "foreground": "#79b8ac"
            }
        },
        {
            "scope": [
                "variable.other.field"
            ],
            "settings": {
                "foreground": "#79b8ac"
            }
        },
        {
            "scope": [
                "variable.other",
                "variable.other.local",
                "variable.other.global"
            ],
            "settings": {
                "foreground": "#e6e6e6"
            }
        },
        {
            "scope": [
                "punctuation.definition.array"
            ],
            "settings": {
                "foreground": "#e6e6e6"
            }
        },
        {
            "scope": [
                "variable.function"
            ],
            "settings": {
                "foreground": "#79b8ac"
            }
        },
        {
            "scope": [
                "variable.other.field"
            ],
            "settings": {
                "foreground": "#79b8ac"
            }
        },
        {
            "scope": [
                "keyword",
                "storage.type"
            ],
            "settings": {
                "foreground": "#e2769e"
            }
        }
    ]
}
